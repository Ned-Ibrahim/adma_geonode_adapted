# Credentials and mount options for the ADAPT SMB share, used by
# docker-compose.adapt.yml. Copy the values into .env next to the compose file.
# Never commit the real ones.
#
# The account needs read access to the share. It needs write access only if
# write-back is turned on below. A machine account will not work.

ADAPT_HOST=snr18
ADAPT_SHARE=Adapt
ADAPT_USER=
ADAPT_PASS=
ADAPT_DOMAIN=

# Drop to 2.1 if the mount fails to negotiate 3.0.
ADAPT_SMB_VERSION=3.0

# Write-back: uploading from ADMA onto the share.
#
# Off by default. Turning it on takes ADAPT_ACCESS=rw, the two modes and
# ADAPT_WRITE_ENABLED=True below, plus an account above with write permission on
# the share. Every write reaches the share as that one account, and its name is
# what the file server's audit log shows for every upload any ADMA user makes.
# Which ADMA users may upload where is decided in ADMA by folder grants with
# "can write" ticked; a read grant never allows an upload.
#
# ADAPT_ACCESS mounts the share read-write. Without it the kernel rejects the
# write no matter what Django thinks.
#   ro  = read-only  (default)
#   rw  = read-write
ADAPT_ACCESS=ro

# Permission bits the mount presents. A read-write mount still needs writable
# bits; 0444/0555 is unwritable whatever the SMB session may do.
#   read-only:  0444 / 0555
#   read-write: 0644 / 0755
ADAPT_FILE_MODE=0444
ADAPT_DIR_MODE=0555

# Whether Django will attempt a write at all. Kept separate from ADAPT_ACCESS on
# purpose, so the mount can be made writable and tested before the application
# starts using it.
ADAPT_WRITE_ENABLED=False

# Optional narrowing of where uploads may land: comma-separated paths relative
# to the share root. Empty means the whole share is writable.
#   ADAPT_WRITABLE_PREFIXES=Data Management,Shared/Incoming
ADAPT_WRITABLE_PREFIXES=
