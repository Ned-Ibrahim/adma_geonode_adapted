# Credentials for the ADAPT SMB share, used by docker-compose.adapt.yml.
# Copy the values into .env next to the compose file. Never commit the real ones.
#
# The account needs read access to the share and nothing more. A machine account
# will not work.

ADAPT_HOST=snr18
ADAPT_SHARE=Adapt
ADAPT_USER=
ADAPT_PASS=
ADAPT_DOMAIN=

# Drop to 2.1 if the mount fails to negotiate 3.0.
ADAPT_SMB_VERSION=3.0

# --- Permissions (branch adapt-permissions) ---------------------------------
# sync_adapt_acls reads each folder's security descriptor over SMB with the
# same account as the mount. No extra variables needed for that.
#
# Active Directory login. Leave LDAP_URI empty to keep plain Django accounts.
# Find the domain controller from a domain-joined host: nltest /dsgetdc:nead
LDAP_URI=
# e.g. DC=nead,DC=unl,DC=edu (ask the AD admin, or: (Get-ADDomain).DistinguishedName)
LDAP_BASE_DN=
# Bind identity for lookups. Defaults to ADAPT_USER@LDAP_UPN_SUFFIX with ADAPT_PASS.
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_UPN_SUFFIX=
# Optional: only members of this group (DN) may log in at all.
LDAP_REQUIRE_GROUP=
# Mirror AD groups into Django groups on every login (True/False).
LDAP_MIRROR_GROUPS=True
# CA certificate for ldaps://, mounted into the container. Never disable verification.
LDAP_CA_CERT_FILE=
LDAP_START_TLS=False
