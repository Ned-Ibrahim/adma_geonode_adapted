# Environment Configuration Template
# Copy this file to .env and fill in the values
# .env files are ignored by git for security

# Realm5 API Configuration
REALM5_API_KEY=your_realm5_api_key_here

# Django Configuration (optional overrides)
# SECRET_KEY=your-django-secret-key
# DEBUG=True

# Database Configuration (optional overrides)
# POSTGRES_DB=adma_geo
# POSTGRES_USER=adma_geo
# POSTGRES_PASSWORD=your-db-password
# POSTGRES_HOST=db
# POSTGRES_PORT=5432

# GeoServer Configuration (optional overrides)
# GEOSERVER_URL=http://geoserver:8080/geoserver
# GEOSERVER_ADMIN_USER=admin
# GEOSERVER_ADMIN_PASSWORD=your-geoserver-password
