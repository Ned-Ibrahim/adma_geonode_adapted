# Credentials for mounting the ADAPT share as the ADMA media volume.
# Used only by docker-compose.share.yml. Copy the values into .env.
# .env is gitignored. Never commit real credentials.

ADAPT_SMB_HOST=snr18
# Share plus path, no leading slash. Example below matches
# \\snr18\Adapt\Data Management\Workspace\adma_geo_production\media
ADAPT_SMB_PATH=Adapt/Data Management/Workspace/adma_geo_production/media
ADAPT_SMB_USER=
ADAPT_SMB_PASSWORD=
ADAPT_SMB_DOMAIN=
